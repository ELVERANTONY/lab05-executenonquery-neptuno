<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NeptunoApp.ViewModels" x:Class="NeptunoApp.Views.ProveedoresView" x:DataType="vm:ProveedoresViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="20,22">
    <TextBlock Text="Mantenimiento y búsqueda de proveedores" FontSize="26" FontWeight="Bold"/>

    <!-- Barra de Filtros de Búsqueda -->
    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14">
      <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="12">
        <TextBox PlaceholderText="Buscar por nombre de contacto..." Text="{Binding FiltroContacto}"/>
        <TextBox Grid.Column="1" PlaceholderText="Buscar por ciudad..." Text="{Binding FiltroCiudad}"/>
        <Button Grid.Column="2" Classes="primary" Content="Buscar" Command="{Binding BuscarCommand}" MinWidth="95" HorizontalContentAlignment="Center"/>
        <Button Grid.Column="3" Content="Limpiar" Command="{Binding LimpiarBusquedaCommand}" MinWidth="95" HorizontalContentAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="340,*" ColumnSpacing="18">
      <!-- Tarjeta de Formulario -->
      <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
        <ScrollViewer>
          <StackPanel Spacing="9">
            <TextBlock Text="Datos del proveedor" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            
            <TextBlock Text="Compañía *" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox Text="{Binding Compania}" MaxLength="60" PlaceholderText="Nombre de la empresa"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel Spacing="4">
                <TextBlock Text="Contacto" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox Text="{Binding Contacto}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Cargo" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox Text="{Binding Cargo}"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="Dirección" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox Text="{Binding Direccion}"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel Spacing="4">
                <TextBlock Text="Ciudad" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox Text="{Binding Ciudad}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Código postal" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox Text="{Binding CodigoPostal}"/>
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel Spacing="4">
                <TextBlock Text="País" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox Text="{Binding Pais}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Teléfono" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox Text="{Binding Telefono}"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="Fax" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox Text="{Binding Fax}"/>

            <TextBlock Text="{Binding Mensaje}" Foreground="#0F766E" TextWrapping="Wrap" FontWeight="SemiBold"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
              <Button Content="Nuevo / Cancelar" Command="{Binding NuevoCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
              <Button Grid.Column="1" Classes="orange" Content="Guardar" Command="{Binding GuardarCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Tarjeta de Tabla -->
      <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto">
          <ProgressBar IsVisible="{Binding EstaCargando}" IsIndeterminate="True" Margin="0,0,0,8"/>
          
          <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Proveedores}" SelectedItem="{Binding Seleccionado}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ProveedorID}" Width="60"/>
                <DataGridTextColumn Header="Compañía" Binding="{Binding CompaniaNombre}" Width="1.6*" MinWidth="190"/>
                <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="1.2*" MinWidth="150"/>
                <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="1.0*" MinWidth="110"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="1.1*" MinWidth="130"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
            <Button Classes="primary" Content="Editar" Command="{Binding EditarCommand}" CommandParameter="{Binding Seleccionado}" MinWidth="95" HorizontalContentAlignment="Center"/>
            <Button Classes="danger" Content="Eliminar" Command="{Binding EliminarCommand}" CommandParameter="{Binding Seleccionado}" MinWidth="95" HorizontalContentAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
