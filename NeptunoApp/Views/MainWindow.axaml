<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NeptunoApp.ViewModels" xmlns:views="using:NeptunoApp.Views"
        x:Class="NeptunoApp.Views.MainWindow" x:DataType="vm:MainViewModel"
        Title="Neptuno · Laboratorio ADO.NET" Width="1380" Height="860" MinWidth="1050" MinHeight="680" Background="#F1F5F9">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding AnchoBarra}"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Barra lateral elegante con opción de colapsar -->
    <Border Background="#0F172A" Padding="12,20">
      <Grid RowDefinitions="Auto,Auto,*">
        <!-- Encabezado / Logo + Botón Toggle -->
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <Border Width="40" Height="40" CornerRadius="10" Background="#0F766E" HorizontalAlignment="Left">
            <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Grid.Column="1" Text="NEPTUNO" Foreground="White" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" IsVisible="{Binding MostrarTextoBarra}"/>
          <Button Grid.Column="2" Command="{Binding AlternarBarraCommand}" Background="Transparent" Foreground="#94A3B8" Padding="6" CornerRadius="6" HorizontalAlignment="Right" ToolTip.Tip="Ocultar/Mostrar menú">
            <TextBlock Text="☰" FontSize="16" FontWeight="Bold"/>
          </Button>
        </Grid>

        <!-- Etiqueta Sección -->
        <TextBlock Grid.Row="1" Text="MÓDULOS" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="4,28,0,8" IsVisible="{Binding MostrarTextoBarra}"/>

        <!-- Navegación -->
        <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
          <!-- Productos -->
          <Button Classes="nav" Classes.active="{Binding MostrarProductos}" Command="{Binding VerProductosCommand}" ToolTip.Tip="Productos" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="📦" FontSize="16"/>
              <TextBlock Text="Productos" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).MostrarTextoBarra}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Categorías -->
          <Button Classes="nav" Classes.active="{Binding MostrarCategorias}" Command="{Binding VerCategoriasCommand}" ToolTip.Tip="Categorías" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="🏷️" FontSize="16"/>
              <TextBlock Text="Categorías" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).MostrarTextoBarra}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Proveedores -->
          <Button Classes="nav" Classes.active="{Binding MostrarProveedores}" Command="{Binding VerProveedoresCommand}" ToolTip.Tip="Proveedores" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="🏢" FontSize="16"/>
              <TextBlock Text="Proveedores" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).MostrarTextoBarra}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Pedidos -->
          <Button Classes="nav" Classes.active="{Binding MostrarPedidos}" Command="{Binding VerPedidosCommand}" ToolTip.Tip="Pedidos" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="📋" FontSize="16"/>
              <TextBlock Text="Pedidos" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).MostrarTextoBarra}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Reportes -->
          <Button Classes="nav" Classes.active="{Binding MostrarReportes}" Command="{Binding VerReportesCommand}" ToolTip.Tip="Reporte por fechas" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="📊" FontSize="16"/>
              <TextBlock Text="Reportes" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).MostrarTextoBarra}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Contenido Principal -->
    <Grid Grid.Column="1">
      <Grid IsVisible="{Binding MostrarProductos}"><views:ProductosView DataContext="{Binding Productos}"/></Grid>
      <Grid IsVisible="{Binding MostrarCategorias}"><views:CategoriasView DataContext="{Binding Categorias}"/></Grid>
      <Grid IsVisible="{Binding MostrarProveedores}"><views:ProveedoresView DataContext="{Binding Proveedores}"/></Grid>
      <Grid IsVisible="{Binding MostrarPedidos}"><views:PedidosView DataContext="{Binding Pedidos}"/></Grid>
      <Grid IsVisible="{Binding MostrarReportes}"><views:ReportesView DataContext="{Binding Reportes}"/></Grid>
    </Grid>
  </Grid>
</Window>
