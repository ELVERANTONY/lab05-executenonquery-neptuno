<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NeptunoApp.ViewModels" x:Class="NeptunoApp.Views.ReportesView" x:DataType="vm:ReportesViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="20,22">
    <StackPanel>
      <TextBlock Text="Reporte de detalles de pedidos" FontSize="26" FontWeight="Bold"/>
      <TextBlock Text="Consulta mediante INNER JOIN y rango de fechas (excluye pedidos inactivos)" Foreground="#64748B"/>
    </StackPanel>

    <!-- Barra de Filtros de Fechas -->
    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,16">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,Auto" ColumnSpacing="16" RowSpacing="10">
        <StackPanel Spacing="5">
          <TextBlock Text="Fecha inicial" Foreground="#334155" FontWeight="SemiBold"/>
          <DatePicker SelectedDate="{Binding FechaInicio}" HorizontalAlignment="Stretch" DayFormat="dd" MonthFormat="MMMM" YearFormat="yyyy"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="5">
          <TextBlock Text="Fecha final" Foreground="#334155" FontWeight="SemiBold"/>
          <DatePicker SelectedDate="{Binding FechaFin}" HorizontalAlignment="Stretch" DayFormat="dd" MonthFormat="MMMM" YearFormat="yyyy"/>
        </StackPanel>
        <Button Grid.Column="2" Classes="orange" Content="Consultar" Command="{Binding ConsultarCommand}" VerticalAlignment="Bottom" MinWidth="120" HorizontalContentAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Mensaje}" Foreground="#0F766E" TextWrapping="Wrap" FontWeight="SemiBold"/>
      </Grid>
    </Border>

    <!-- Tarjeta de Tabla de Reporte -->
    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
      <Grid RowDefinitions="Auto,*,Auto">
        <ProgressBar IsVisible="{Binding EstaCargando}" IsIndeterminate="True" Margin="0,0,0,8"/>
        
        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
          <DataGrid ItemsSource="{Binding Lineas}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Pedido" Binding="{Binding PedidoID}" Width="75"/>
              <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPedido, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
              <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCliente}" Width="1.4*" MinWidth="180"/>
              <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="1.4*" MinWidth="175"/>
              <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad, StringFormat='S/ {0:N2}'}" Width="100"/>
              <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="85"/>
              <DataGridTextColumn Header="Descuento" Binding="{Binding Descuento, StringFormat='{}{0:P0}'}" Width="100"/>
              <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat='S/ {0:N2}'}" Width="105"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Total, StringFormat='Total general: S/ {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#0F766E" HorizontalAlignment="Right" Margin="0,14,8,0"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
