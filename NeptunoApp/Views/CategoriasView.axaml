<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NeptunoApp.ViewModels" x:Class="NeptunoApp.Views.CategoriasView" x:DataType="vm:CategoriasViewModel">
  <Grid RowDefinitions="Auto,*" Margin="20,22">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Mantenimiento de categorías" FontSize="26" FontWeight="Bold"/>
        <TextBlock Text="Clasificación de productos (con eliminación lógica)" Foreground="#64748B"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="primary" Content="Actualizar" Command="{Binding CargarCommand}"/>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="18">
      <!-- Tarjeta de Formulario -->
      <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
        <StackPanel Spacing="10">
          <TextBlock Text="Datos de categoría" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
          
          <TextBlock Text="Nombre de la categoría *" FontWeight="SemiBold" Foreground="#334155"/>
          <TextBox Text="{Binding Nombre}" MaxLength="30" PlaceholderText="Ej. Bebidas"/>

          <TextBlock Text="Descripción" FontWeight="SemiBold" Foreground="#334155"/>
          <TextBox Text="{Binding Descripcion}" MaxLength="200" AcceptsReturn="True" Height="110" TextWrapping="Wrap" PlaceholderText="Detalle de la categoría..."/>

          <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="#0F766E" FontWeight="SemiBold"/>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
            <Button Content="Nuevo / Cancelar" Command="{Binding NuevoCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Button Grid.Column="1" Classes="orange" Content="Guardar" Command="{Binding GuardarCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Tarjeta de Tabla -->
      <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding EstaCargando}" Margin="0,0,0,8"/>
          
          <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Categorias}" SelectedItem="{Binding Seleccionada}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding CategoriaID}" Width="70"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="1.3*" MinWidth="160"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*" MinWidth="240"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
            <Button Classes="primary" Content="Editar" Command="{Binding EditarCommand}" CommandParameter="{Binding Seleccionada}" MinWidth="95" HorizontalContentAlignment="Center"/>
            <Button Classes="danger" Content="Eliminar" Command="{Binding EliminarCommand}" CommandParameter="{Binding Seleccionada}" MinWidth="95" HorizontalContentAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
