<UserControl x:Class="Neptuno.WPF.Views.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="24,20">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mantenimiento de categorías" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Clasificación de los productos" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource PrimaryButton}" Content="Actualizar" Command="{Binding CargarCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="18,7"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form Card -->
            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Datos de categoría" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                        <TextBlock Text="Nombre *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" Margin="0,0,0,10"/>

                        <TextBlock Text="Descripción" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AcceptsReturn="True" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding Mensaje}" Foreground="#0F766E" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Nuevo / Cancelar" Command="{Binding NuevoCommand}"/>
                            <Button Grid.Column="2" Style="{StaticResource OrangeButton}" Content="Guardar" Command="{Binding GuardarCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Grid Card -->
            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Categorias}" SelectedItem="{Binding Seleccionada}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding CategoriaID}" Width="60"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="1.5*"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Editar" Command="{Binding EditarCommand}" CommandParameter="{Binding Seleccionada}" Margin="0,0,8,0" Padding="20,7"/>
                        <Button Style="{StaticResource DangerButton}" Content="Eliminar" Command="{Binding EliminarCommand}" CommandParameter="{Binding Seleccionada}" Padding="20,7"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
